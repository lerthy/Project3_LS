# AWS Configuration
aws_region = "eu-north-1"

# Database Configuration
db_name     = "contacts"
db_username = "appuser"
db_password = "" # Leave empty to use SSM parameters

# SSM Parameter Names (used when corresponding variables are empty)
db_username_ssm_name = "/project3/db/username"
db_password_ssm_name = "/project3/db/password"
db_name_ssm_name     = "/project3/db/name"

# CodeStar Connection
codestar_connection_arn = ""
